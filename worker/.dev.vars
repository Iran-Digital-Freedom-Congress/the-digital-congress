JOMHOOR_CLIENT_ID=difcongress
JOMHOOR_SSO_URL=http://localhost:8003
JOMHOOR_CLIENT_SECRET=local-dev-secret
WORKER_URL=http://localhost:8787
FRONTEND_URL=http://localhost:8080

# Q6 — Jomhoor SSO admin bearer token. When set, the Worker stamps a
# `difcongress_member` assertion in sso-svc after a successful SSO callback,
# enabling cross-RP gating via `requires_difcongress` on other clients.
# Copy from platform/services/sso-svc/.env (SSO_ADMIN_TOKEN). Leave blank
# to disable stamping (callback still succeeds; cross-RP gate just won't fire).
JOMHOOR_ADMIN_TOKEN=
